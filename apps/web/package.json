{
  "name": "@openfeeds/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite",
    "build": "bun --bun vite build",
    "start": "bun --bun --env-file=.env server.js",
    "serve": "bun --bun vite preview",
    "test": "bun --bun vitest",
    "lint": "oxlint -c oxlint.config.mjs src",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@kobalte/core": "2.0.0-alpha.0",
    "@openfeeds/shared": "workspace:*",
    "@remix-run/cookie": "^0.5.4",
    "@solidjs/meta": "^1.0.0-next.2",
    "@solidjs/router": "2.0.0-next.16",
    "@solidjs/web": "2.0.0-rc.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "feedsmith": "3.0.0-rc.3",
    "solid-js": "2.0.0-rc.0",
    "tailwind-merge": "^3.6.0",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@solidjs/testing-library": "1.0.0-beta.2",
    "@solidjs/vite-plugin": "3.0.0-next.29",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.6.3",
    "@types/bun": "^1.4.0",
    "@types/node": "^26.2.0",
    "drizzle-kit": "^0.31.10",
    "eslint-plugin-solid": "~0.16.0",
    "filesystem-routing": "0.2.1",
    "jsdom": "^25.0.1",
    "oxlint": "~1.79.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.2",
    "vite": "^8.1.5",
    "vitest": "^4.0.0"
  }
}
