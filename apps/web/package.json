{
  "name": "@openfeeds/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite",
    "build": "bun --bun vite build",
    "start": "bun --bun --env-file=.env server.js",
    "serve": "bun --bun vite preview",
    "test": "bun --bun vitest",
    "lint": "oxlint -c oxlint.config.mjs --deny-warnings .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@kobalte/core": "2.0.0-alpha.2",
    "@openfeeds/shared": "workspace:*",
    "@solidjs/meta": "1.0.0-next.2",
    "@solidjs/router": "2.0.0-next.26",
    "@solidjs/web": "2.0.0-rc.9",
    "better-auth": "^1.7.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "feedsmith": "^3.0.0",
    "solid-js": "2.0.0-rc.9",
    "tailwind-merge": "^3.7.0",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@solidjs/testing-library": "1.0.0-beta.3",
    "@solidjs/vite-plugin": "3.0.0-next.44",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/bun": "^1.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint-plugin-solid": "^0.18.0",
    "filesystem-routing": "0.3.1",
    "jsdom": "^29.1.1",
    "oxlint": "^1.83.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
