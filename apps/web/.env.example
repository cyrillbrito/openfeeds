# Copy this file to .env to get started; deploy platforms provide the real
# values as environment variables. Every variable is declared and validated
# in env.ts — server vars at boot (runtime process.env reads), VITE_-prefixed
# client vars at build time (baked into the bundle; never put secrets there).

# Signs and encrypts Better Auth sessions and tokens. At least 32 chars.
# Generate one:  openssl rand -base64 32
BETTER_AUTH_SECRET=

# The app's public origin, used to build the Google OAuth callback URL.
# Defaults to http://localhost:3000.
BETTER_AUTH_URL=

# Google sign-in. Optional; both must be set for it to be enabled. Create
# the credentials at console.cloud.google.com > APIs & Services >
# Credentials > OAuth client ID > Web application, with redirect URI
#   <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Postgres connection string. Unset is fine for local development: the
# default matches the service in ../../compose.yml, so `docker compose up -d`
# from the repo root is the whole setup. Migrations run at boot.
# Defaults to postgres://openfeeds:openfeeds@localhost:5432/openfeeds
DATABASE_URL=

# Development only. Adds this many milliseconds to every data-layer server
# function so loading spinners and pending states are actually visible on
# localhost. Try 1500. Unset or 0 means no delay; production builds ignore it.
SYNTHETIC_DELAY_MS=
