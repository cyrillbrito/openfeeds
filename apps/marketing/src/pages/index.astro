---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <main class="bg-background flex min-h-[calc(100vh-81px)] items-center justify-center px-6">
    <div class="text-center">
      <h1 class="font-display text-foreground mb-6 text-5xl leading-tight md:text-7xl">
        under construction
      </h1>
      <p class="text-foreground/70 mx-auto max-w-xl text-lg md:text-xl">
        OpenFeeds is taking a break while we rethink things. Check back later.
      </p>
    </div>
  </main>
</Layout>
